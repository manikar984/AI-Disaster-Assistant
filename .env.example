# Disaster Assistant configuration. Copy to .env (never commit it) and export it,
# or use the Compose env_file. Every value below is a placeholder.
DATABASE_PATH=./data/assistant.db
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- Source registry (all feeds are opt-in) ----------------------------------
# Nothing is fetched until a source is enabled. Defaults stay on the official
# endpoint published by the provider; override only for a documented mirror or a
# local test fixture. See docs/SOURCES.md.
USGS_ENABLED=false
USGS_INTERVAL=60
#USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
GDACS_ENABLED=false
GDACS_INTERVAL=300
#GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
# News/bulletin feeds: comma-separated "Publisher|https://feed-url" pairs.
NEWS_ENABLED=true
NEWS_INTERVAL=300
NEWS_FEEDS=
# CAP 1.2 warning feeds from official alerting authorities (same pair syntax).
CAP_ENABLED=true
CAP_INTERVAL=120
CAP_FEEDS=

# --- Notification delivery ---------------------------------------------------
# Leave SMTP_HOST empty to keep email disabled. Prove the channel after
# configuring it:  python -m backend.cli email-check --to you@example.org
SMTP_HOST=
SMTP_PORT=587
# starttls (587, default) | ssl (465) | plain (a local relay without TLS only)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=20

# --- Not implemented; kept so the gap is explicit ----------------------------
# X/social adapter is not wired to the worker. Rotate any token that was ever
# committed before enabling a paid provider plan.
X_BEARER_TOKEN=
